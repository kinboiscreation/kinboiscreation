  "dependencies": {
    "@remotion/captions": "^4.0.520",
    "@remotion/cli": "^4.0.520",
    "@remotion/gif": "^4.0.520",
    "@remotion/media-utils": "^4.0.520",
    "@remotion/noise": "^4.0.520",
    "@remotion/paths": "^4.0.520",
    "@remotion/shapes": "^4.0.520",
    "@remotion/tailwind": "^4.0.520",
    "@remotion/three": "^4.0.520",
    "@remotion/transitions": "^4.0.520",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.520",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
