{
  "name": "kinboiscreation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "remotion preview src/index.tsx",
    "build": "remotion render src/index.tsx BlankCanvas --output ./out/blank-canvas.mp4",
    "render:all": "remotion render src/index.tsx --output ./out/composition-[composition].mp4",
    "render:shapes": "remotion render src/index.tsx ShapesPlayground --output ./out/shapes.mp4",
    "render:paths": "remotion render src/index.tsx PathsPlayground --output ./out/paths.mp4",
    "render:transitions": "remotion render src/index.tsx TransitionsPlayground --output ./out/transitions.mp4",
    "render:media": "remotion render src/index.tsx MediaPlayground --output ./out/media.mp4",
    "render:noise": "remotion render src/index.tsx NoisePlayground --output ./out/noise.mp4",
    "render:three": "remotion render src/index.tsx ThreePlayground --output ./out/three.mp4",
    "render:batch": "npm run render:shapes && npm run render:paths && npm run render:transitions && npm run render:media && npm run render:noise && npm run render:three",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinboiscreation/kinboiscreation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kinboiscreation/kinboiscreation/issues"
  },
  "homepage": "https://github.com/kinboiscreation/kinboiscreation#readme",
  "dependencies": {
    "@remotion/captions": "^4.0.520",
    "@remotion/gif": "^4.0.520",
    "@remotion/media-utils": "^4.0.520",
    "@remotion/noise": "^4.0.520",
    "@remotion/paths": "^4.0.520",
    "@remotion/shapes": "^4.0.520",
    "@remotion/tailwind": "^4.0.520",
    "@remotion/three": "^4.0.520",
    "@remotion/transitions": "^4.0.520",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.520",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
