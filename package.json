{
  "name": "kinboiscreation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "remotion studio",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:blank": "remotion render src/index.ts BlankCanvas --output ./out/blank-canvas.mp4",
    "render:shapes": "remotion render src/index.ts ShapesPlayground --output ./out/shapes.mp4",
    "render:paths": "remotion render src/index.ts PathsPlayground --output ./out/paths.mp4",
    "render:transitions": "remotion render src/index.ts TransitionsPlayground --output ./out/transitions.mp4",
    "render:media": "remotion render src/index.ts MediaPlayground --output ./out/media.mp4",
    "render:noise": "remotion render src/index.ts NoisePlayground --output ./out/noise.mp4",
    "render:three": "remotion render src/index.ts ThreePlayground --output ./out/three.mp4",
    "render:all": "remotion render src/index.ts --output ./out/[composition].mp4",
    "render:batch": "npm run render:shapes && npm run render:paths && npm run render:transitions && npm run render:media && npm run render:noise && npm run render:three",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinboiscreation/kinboiscreation.git"
  },
